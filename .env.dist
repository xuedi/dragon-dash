# Committed defaults. Copy what you need into .env.local, which is gitignored
# and is where credentials belong. Real environment variables win over both.

# Where the server listens. Use :80 for the default HTTP port, the packaged
# systemd unit grants the capability that needs. The -addr flag overrides it.
DD_CORE_ADDR=127.0.0.1:9494

# HTTPS turns on when both paths are set, one without the other refuses to
# start. The address above then redirects here, except /metrics, which
# Prometheus keeps scraping over plain HTTP. Use :443 on a server.
#DD_CORE_TLS_CERT=/etc/dragon-dash/tls/dragon-dash.crt
#DD_CORE_TLS_KEY=/etc/dragon-dash/tls/dragon-dash.key
DD_CORE_TLS_ADDR=127.0.0.1:9495

# Where every metric is read from.
DD_CORE_PROMETHEUS_URL=http://127.0.0.1:9090

# Systems are compiled in; these decide what appears in the navbar.
DD_SYSTEM_DRAGON_ENABLED=1
DD_SYSTEM_FRITZHOME_ENABLED=1

# Extra navbar entries that show another site below the navbar. List the ids
# in order, then give each a URL. MODE is frame (the default, the browser loads
# the URL in an iframe), proxy (dragon-dash forwards /x/<id>/ to the URL, which
# then only needs to be reachable from here) or tab (opens a new tab). A
# proxied site must generate its links under /x/<id>/, see docs/links.md.
#DD_LINKS=wiki
#DD_LINK_WIKI_TITLE=Wiki
#DD_LINK_WIKI_URL=http://127.0.0.1:8081
#DD_LINK_WIKI_MODE=proxy

# FRITZ!Box. Credentials go in .env.local, never here.
DD_SYSTEM_FRITZHOME_URL=http://fritz.box
DD_SYSTEM_FRITZHOME_USERNAME=
DD_SYSTEM_FRITZHOME_PASSWORD=

# How often the box is polled for the /metrics endpoint Prometheus scrapes.
DD_SYSTEM_FRITZHOME_INTERVAL=60s
