# Copy to .env and fill in. Gitignored: it holds the FRITZ!Box password.
#
# Create a dedicated FRITZ!Box user rather than reusing your admin login:
#   FRITZ!Box UI > System > FRITZ!Box Users > Add User
#   The user needs the "Smart Home" permission.

DD_SYSTEM_FRITZHOME_URL=http://fritz.box
DD_SYSTEM_FRITZHOME_USERNAME=
DD_SYSTEM_FRITZHOME_PASSWORD=
DD_SYSTEM_FRITZHOME_INTERVAL=60s
