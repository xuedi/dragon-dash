# Copy to .env and fill in. .env is gitignored, it holds a router password.
#
# Create a dedicated FRITZ!Box user rather than reusing your admin login:
#   FRITZ!Box UI > System > FRITZ!Box Users > Add User
#   Permissions needed: "FRITZ!Box Settings" and "Smart Home"
# TR-064 must also be enabled:
#   Home Network > Network > Network Settings > "Allow access for applications"

FRITZ_HOSTNAME=fritz.box
FRITZ_USERNAME=
FRITZ_PASSWORD=
